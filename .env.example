# Copy to .env for local development. Never commit the real .env.
#
# `python app.py` and gunicorn load .env from the repository root. A real
# environment variable always takes precedence over this file, so a stray .env
# can never shadow a production secret.

# ---- Required in production -------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start in production without this, rather than falling back
# to a random per-process key that silently breaks sessions across workers.
SECRET_KEY=

# production | development | testing
FLASK_ENV=development

# ---- Storage ----------------------------------------------------------------
DATABASE_PATH=loanwise.db
MODEL_DIR=models

# ---- Server -----------------------------------------------------------------
PORT=5000
HOST=127.0.0.1
# Set only when running behind a proxy you control. It makes the app trust
# X-Forwarded-For for rate limiting; trusting a spoofable header otherwise lets
# a caller mint a fresh rate-limit bucket per request.
# TRUSTED_PROXY=1

# ---- Session ----------------------------------------------------------------
SESSION_LIFETIME_SECONDS=3600
# Defaults to true in production. Set false only for local HTTP development.
# SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# ---- Rate limits (per client IP, <requests>/<seconds>) ----------------------
# Per process: N gunicorn workers allow roughly N times these. Behind a
# corporate NAT many users share one IP, so raise RATE_LIMIT_PREDICT if a whole
# office uses the tool. A malformed value stops the app from starting.
# RATE_LIMIT_LOGIN=10/300
# RATE_LIMIT_REGISTER=5/3600
# RATE_LIMIT_PREDICT=30/3600

# ---- Lending assumptions ----------------------------------------------------
# Reference rate for the affordability figures shown to the applicant, as a
# fraction (0.105 = 10.5%). It does NOT change the model's prediction: the model
# computes its instalment feature at the rate it was trained with, which is
# recorded in the bundle. Changing this used to skew every prediction.
ANNUAL_INTEREST_RATE=0.105
# Instalment-to-income ceiling used by the affordability rule.
MAX_EMI_TO_INCOME=0.50

# ---- Decision bands ---------------------------------------------------------
# Must satisfy 0 < BORDERLINE < APPROVE < 1.
APPROVE_THRESHOLD=0.65
BORDERLINE_THRESHOLD=0.40
