# Copy to .env and adjust. .env is git-ignored — never commit real secrets.

# Application
# 'development' relaxes the checks below and enables the Flask debugger.
# Anything else is treated as production.
FLASK_ENV=development
PORT=5000

# Session signing key. REQUIRED whenever FLASK_ENV is not 'development' —
# the app refuses to start without it, because a per-process random key
# invalidates every session on restart. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Admin account, seeded on first run.
# With ADMIN_PASSWORD unset, development seeds admin/admin123 and production
# creates no admin account at all.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# SQLite file. Needs a writable directory — see the deployment notes in
# README.md before pointing this at a serverless platform.
DATABASE_PATH=loan_prediction.db

# Directory holding the trained .pkl artefacts.
MODEL_PATH=models
