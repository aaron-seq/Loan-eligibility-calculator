# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
loan_env/

# Local state — never commit a database with real user data
*.db
*.db-wal
*.db-shm

# Secrets
.env
.env.*
!.env.example

# Test / tooling output
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.mypy_cache/

# The trained bundle is committed on purpose (see docs/DEPLOYMENT.md), but
# nothing else in models/ is.
models/*
!models/loan_model.joblib
!models/metrics.json
